{
  "schema_version": 3,
  "id": "2026-10-22-playwright-main-evaluate-promise-collected",
  "detected_by": "ci",
  "recurrence_check_on": "2026-11-21",
  "problem_type": "Playwright 对 Electron 主进程的 evaluate 在主进程正忙时丢失结果回包，并被改写成误导性的导航报错",
  "symptom": "CI「Mac Package」打包冒烟 tests/ux/packaged-mcp-smoke.e2e.mjs 读主进程 env 时偶发 `electronApplication.evaluate: Execution context was destroyed, most likely because of a navigation.`（10-18 起 6 次；Linux 画布验收 / 核心冒烟 / 画布跟手各见过同一句）",
  "direct_cause": "Node 调试协议对 Runtime.callFunctionOn 回 {\"code\":-32000,\"message\":\"Promise was collected\"}；playwright-core 的 crExecutionContext.rewriteError 把一切认不出的协议错误改写成「Execution context was destroyed」。本机 Windows 打包产物 30 次启动挂 3 次，DEBUG=pw:protocol 抓到的三次原文全是这一句。",
  "class_root": "Playwright 每次 evaluate 都带 awaitPromise:true；V8 调试器把返回值包成 promise 且只弱引用它，等微任务回调才回包。Electron 主进程（Node 调试器）在 JS 正忙时用中断插队执行调试消息，回包要等这段同步代码跑完，期间任何一次 GC 都能把那个 promise 收掉。缺的不变量：「evaluate 的结果在送达前一直强可达」——没有任何一层保证它，所以一切主进程 evaluate 入口在主进程忙时都会偶发丢结果。",
  "affected_population": [
    "所有经 Playwright 对 Electron 主进程求值的测试入口：app.evaluate / app.evaluateHandle / app.browserWindow / 主进程 JSHandle.evaluate（tests/ux、evals、scripts 下的走查、冒烟、评测、性能脚本）",
    "macOS / Windows / Linux 三平台（同一 V8 行为；本机 Windows 打包产物与开发版 Electron 均已复现）",
    "渲染进程 page.evaluate 不受影响：Chromium 在任务之间派发 CDP，不插队（实测主线程忙循环 30/30 正常）"
  ],
  "scope_paths": [
    "patches/playwright-core@1.60.0.patch",
    "package.json",
    "pnpm-lock.yaml",
    "tests/ux/_launchApp.mjs",
    "tests/ux/playwright-main-evaluate.e2e.mjs",
    "tests/ux/playwright-main-evaluate.busy-main.cjs",
    ".github/workflows/nightly-walkthroughs.yml",
    "scripts/check-quality-gate-workflow.node-test.mjs"
  ],
  "entry_points": [
    "tests/ux/packaged-mcp-smoke.e2e.mjs 读 GUI 主进程 NOMI_CAPABILITY_DIR（报道案例）",
    "tests/ux/_launchApp.mjs 启动器里的 app.browserWindow + setContentSize（每条走查都过）",
    "其余经 browserWindow（door-map 126 个文件）与 app.evaluate（88 个文件）读写主进程的走查 / 评测脚本"
  ],
  "external_sources": [
    {
      "kind": "source-code",
      "url": "https://github.com/microsoft/playwright/issues/41826",
      "checked_at": "2026-10-22",
      "purpose": "同一现象（\"Promise was collected\" 被改写成 context destroyed）；维护者判定为 V8 行为、Playwright 侧不修"
    },
    {
      "kind": "source-code",
      "url": "https://github.com/microsoft/playwright/pull/27867",
      "checked_at": "2026-10-22",
      "purpose": "2023 年同一现象的修补 PR（返回值包一层 Promise.resolve），未合入"
    },
    {
      "kind": "source-code",
      "url": "https://github.com/tlockney/cdp-kernel/issues/55",
      "checked_at": "2026-10-22",
      "purpose": "独立复现：awaitPromise 下普通返回值也被弱持有，GC 即失败；建议目标侧强引用到落定后"
    },
    {
      "kind": "source-code",
      "url": "https://github.com/v8/v8/blob/main/src/inspector/injected-script.cc",
      "checked_at": "2026-10-22",
      "purpose": "ProtocolPromiseHandler 弱持有结果 promise、被回收时回 \"Promise was collected\""
    }
  ],
  "invariants": [
    "Playwright 注入的 UtilityScript.evaluate 返回给调试器的结果，在落定后的下一个宏任务之前一直被 UtilityScript 实例强引用",
    "Playwright 改写协议错误时保留原始协议消息，导航报错不再掩盖别的协议失败",
    "打包冒烟每夜至少在 macOS 上跑一次，不只在打包范围文件变动时才跑"
  ],
  "invariant_owner_layer": {
    "layer": "patches/playwright-core@1.60.0.patch",
    "tests": [
      "tests/ux/playwright-main-evaluate.e2e.mjs"
    ],
    "why": "主进程求值结果能否送达只由 Playwright 注入的 UtilityScript 决定，补丁是这一层在本仓库的唯一持有者；类回归测试先核补丁在位，再在主进程持续忙时跑四种结果形态，去掉补丁即红（实测补丁前红）。"
  },
