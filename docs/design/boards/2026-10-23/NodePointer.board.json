{
  "board": "NodePointer",
  "approvedOn": "2026-10-23",
  "stage": "built",
  "visualReview": "用户 10-23 在 Claude Design 画布「指向元素与付费确认卡 D2 样张」第二版（https://claude.ai/artifact/Y8E9jC8RNrKXVuwxUoWv2f，私有）上选 P1 + Q1（协调转述）；四条连带问题 10-23 由协调与用户定（见 decisions）。",
  "sourceBoundary": "板源 = 画布 A1–A5 五格（source/A1-anatomy.dc.html … A5-i18n-dark.dc.html 是原样副本，canvas.json 为画布布局，nomi-ds.css 为画布用的 token 抄本）。preview/NodePointer.html 是把五格去掉 <x-dc> 壳拼成的静态页：样式一字未改，每格样式加前缀隔离、图标 id 加前缀，停掉转圈动画（抽取才确定），用户没选的 P3 区块不进预览。候选由 board-extract 的抽取函数在拼页上抽出。画布里的 Q1–Q4 在 SpendCardQ1 板，Q2 / Q3 / Z / 00 不进清单。",
  "designIntent": "聊天里代表画布节点的通用零件：长得和节点一样、点一下去节点、悬停两边同亮；所有聊天卡共用一个生产组件（付费卡、以后的时间轴改动、任务卡等）。先在设计实验室搭全状态，不接进聊天。",
  "priorArt": [
    {
      "url": "https://en.wikipedia.org/wiki/Brushing_and_linking",
      "takeaway": "联动高亮（Becker & Cleveland 1987）：同一份数据的两个视图，一边选中，另一边同步高亮。",
      "decisionImpact": "确认了「悬停指向元素 ↔ 画布节点同亮」；改了：它要求两边同时可见，所以窄屏另走「先露出目标再回到对话」（A4）。"
    },
    {
      "url": "https://www.nngroup.com/articles/ten-usability-heuristics/",
      "takeaway": "识别优于回忆（Nielsen 十条之六）：把元素、动作做成看得见的，降低记忆负担。",
      "decisionImpact": "确认了选 P1（认脸）而不是 P2（认名字）、P3（认号）；P2 只作窄屏 / 行内形态。"
    },
    {
      "url": "https://doi.org/10.1145/3290605.3300233",
      "takeaway": "人机 AI 交互准则（Amershi 等 CHI 2019）G9「支持高效纠错」：改错的路径要短。",
      "decisionImpact": "确认了「想改就点指向去节点里改」，改的路只有一条；改了：旧 D2 卡里嵌整件生成框的做法作废。"
    }
  ],
  "decisions": [
    {
      "id": "D1",
      "text": "指向元素用 P1 镜像小卡，P2 行内标签作 P1 的窄屏 / 行内形态（同一个零件两种密度）；P3 配对号标不做。付费请示卡用 Q1 一张卡一颗「生成」；Q2、Q3 不做。",
      "source": "用户 10-23 在 D2 样张第二版上选 P1 镜像小卡 + Q1 一张卡一颗「生成」，P2 作 P1 的窄屏 / 行内形态（协调转述）"
    },
    {
      "id": "D2",
      "text": "悬停双向联动用中性样式（深色细线 + 阴影抬一级；闪一下 = ink 12% 淡光晕），不许蓝色描边；蓝只留在进度点 / 转圈上。",
      "source": "协调 10-22 对第一版样张的反馈（设计线报告 D-pointer-d2「第二版修订」第 1 条）"
    },
    {
      "id": "D3",
      "text": "一张脸照真节点组件：标题行 / 镜号、空节点、排队、生成中等待面、失败、结果缩略图；「已删除」「一行摘要」只在指向元素上。",
      "source": "协调 10-22 反馈（D-pointer-d2「第二版修订」第 2 条）"
    },
    {
      "id": "D4",
      "text": "「已删除」只认宿主显式给的 removed（删除事件 / 制作脱离记录）；节点不在画布上、或画布还没载入完，指向元素显示中性占位（同一个框，不说已删除、不可点）。实验室有这一格（np-p1-states）。",
      "source": "协调 10-23 代定（防载入 / 撤销瞬间误报已删除），事后报用户"
    },
    {
      "id": "D5",
      "text": "组指向超过 3 个：露 3 格，第 3 格（标题行仍是那一镜）的画面位置盖「还有 N 个」，N = 总数 − 3；4 个也折。P2 句中标签是 3 个 +「+N」。",
      "source": "协调 10-23 定（I-d2 第②步 plan D-b：板文字「露 3 个 + 还有 N 个」与板图第 3 格的画法按板图读）"
    }
  ],
